# ─────────────────────────────────────────────────────────────
# AZHAI CLOTHING — ENVIRONMENT CONFIGURATION
# ─────────────────────────────────────────────────────────────

# 1. Brevo (Sendinblue) Email Delivery API
# Get your free API key at: https://app.brevo.com/settings/keys/api
VITE_BREVO_API_KEY=your_brevo_v3_api_key_here

# 2. Sender Identity (Must be verified in Brevo Senders & IP)
VITE_SENDER_EMAIL=orders@azhaiclothing.lk
VITE_SENDER_NAME=Azhai Clothing by Preethi
VITE_STORE_URL=https://azhaiclothing.lk

# 3. Brand Assets (Optional - Defaults to /logo-gold.png)
VITE_BRAND_LOGO_URL=

# 4. Supabase Database & Storage
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 5. Payments.lk Gateway (a Payable company - Central Bank of Sri Lanka Certified)
# Get your sandbox key at https://app.payments.lk/admin/setup
PAYMENTS_LK_SECRET_KEY=sk_test_your_secret_key_here
VITE_PAYMENTS_LK_MODE=sandbox
PAYMENTS_LK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# 6. Google Tag Manager (GTM) Container
# Enter your GTM Container ID (e.g. GTM-XXXXXXX) to enable sitewide tracking
VITE_GTM_ID=

# SECURITY NOTE:
# Never prefix private backend secrets (e.g. PAYMENTS_LK_SECRET_KEY) with VITE_.
# Private merchant secret keys must only be kept on serverless Edge Functions / Cloudflare Workers.


